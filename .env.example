# 数据目录：SQLite、bundle 缓存、渲染输出的容器内路径
# 与 compose 的 ./data:/app/data 挂载对应，容器内请勿改动
ZHIYING_DATA_DIR=/app/data

# Worker 角色（M1 仅实现 all，CONTRACT §4.4）
WORKER_ROLE=all

# Web 服务端口（容器内监听端口，与 compose ports 映射对应）
PORT=3000

# 旁白音频：public/ 下的 staticFile 相对路径（渲染 payload 的 audio.narration）
ZHIYING_NARRATION_PATH=full/audio/FullCut_TTS.wav
