# ==================================================================
# 知影环境变量模板。复制为 .env（dev）或 .env.production（生产）使用。
# 真实 .env / .env.production 一律不入 Git（*.env 已 gitignore），生产 chmod 600。
# ==================================================================

# ---------------- development（docker-compose.yml，M1 dev 栈） ----------------
# 数据目录：SQLite、bundle 缓存、渲染输出的容器内路径
# 与 compose 的 ./data:/app/data 挂载对应，容器内请勿改动
ZHIYING_DATA_DIR=/app/data

# Worker 角色（M1 仅实现 all，CONTRACT §4.4）
WORKER_ROLE=all

# Web 服务端口（容器内监听端口，与 compose ports 映射对应）
PORT=3000

# 旁白音频：public/ 下的 staticFile 相对路径（渲染 payload 的 audio.narration）
ZHIYING_NARRATION_PATH=full/audio/FullCut_TTS.wav

# LLM Provider：mock | deepseek。production 禁止 mock 且必须显式配置；
# 未配置时 dev/test fallback mock 并告警。
LLM_PROVIDER=mock

# DeepSeek API Key：仅环境变量，永不入库/入 Git/打印。LLM_PROVIDER=deepseek 时必需。
# 生产环境只注入 zhiying-worker（实证唯一消费者），绝不注入 web/adapter。
# DEEPSEEK_API_KEY=

# 阶段模型覆盖（可选，仅覆盖模型名；thinking 由 stage-models.ts 显式决定）：
# LLM_STAGE_MODEL_RESEARCH=deepseek-v4-pro

# TTS Provider：mock | indextts2。production 禁止 mock 且必须显式配置；
# 未配置时 dev/test fallback mock 并告警。
TTS_PROVIDER=mock

# IndexTTS2 adapter 地址（TTS_PROVIDER=indextts2 时必需）
# INDEXTTS2_BASE_URL=http://127.0.0.1:9880

# API易图像生成（M6.3；仅注入 zhiying-web，绝不入库/入 Git/打印）
# APIYI_API_KEY=
# APIYI_BASE_URL=https://api.apiyi.com
# APIYI_IMAGE_MODEL=gemini-3.1-flash-image
# APIYI_IMAGE_SIZE=1K
# APIYI_IMAGE_ASPECT_RATIO=16:9
# M7：连接超时（默认 30s）与整体响应超时（默认 300s）分离
# APIYI_CONNECT_TIMEOUT_MS=30000
# APIYI_RESPONSE_TIMEOUT_MS=300000
# APIYI_DOWNLOAD_TIMEOUT_MS=60000

# Final Render 编码（M6.3.10，仅 zhiying-worker）：
# REMOTION_NVENC=true → h264_nvenc 优先（需容器 GPU 访问，见
# docker-compose.production.gpu.yml）；真实编码探测失败自动回退 libx264 crf 18
# REMOTION_NVENC=
# NVENC 视频码率（NVENC 与 crf 互斥，以 bitrate 控质量）；默认 8M
# REMOTION_NVENC_BITRATE=

# ---------------- production（docker-compose.production.yml，M4-B） ----------------
# 以下变量由 compose 变量替换消费（--env-file .env.production）。
# 生产 compose 不使用 env_file 注入，各 service environment 显式列举（最小权限）。

# 【secret】DeepSeek API Key —— 只进入 zhiying-worker
DEEPSEEK_API_KEY=

# 宿主目录（Feiniu 建议 /vol1/1000/docker/zhiying 之下；owner 需允许容器 uid 1000 读写）
# SQLite/artifacts 持久化（web+worker RW，同一 bind mount，备份必需）
ZHIYING_HOST_DATA_DIR=
# 静态媒体资产 full/ + pilot/（web+worker RO 挂载 /app/public，备份必需）
ZHIYING_HOST_PUBLIC_DIR=
# voice reference 目录（单一 host voice root；adapter RO 挂载 /voices、worker RO 挂载 /voices——
# legacy referenceAssetPath /voices/x 直接解析；目录内 tts-a/ 子目录即 materialization root，
# worker RW 挂载 /app/data/voice-materializations、web RO 挂载同路径、adapter 经 /voices/tts-a
# 只读可见——TTS-C.1B.3.R1：无独立可漂移 materialization source，无 /voices child bind）
ZHIYING_HOST_VOICES_DIR=
# active voice registry 目录（adapter RO 挂载 /config、worker RW 挂载 /registry；
# 目录内须含 voice-registry.json——TTS-C.1B.3 topology：publisher temp→fsync→rename 原子替换
# 需要目录，单文件 bind 已退役；worker target 独立于 /app/data）
ZHIYING_HOST_REGISTRY_DIR=
# release 镜像 tag（必填，禁止 latest）：
# = 当前经过 review / CI 的 approved production deployment commit short SHA
# （历史：M4-B frozen = 23a675f；后续 M4-C security/deployment hotfix SHA 亦可）
# rollback 通过指定上一 release tag 完成
ZHIYING_RELEASE_TAG=
