# 数据目录：SQLite、bundle 缓存、渲染输出的容器内路径
# 与 compose 的 ./data:/app/data 挂载对应，容器内请勿改动
ZHIYING_DATA_DIR=/app/data

# Worker 角色（M1 仅实现 all，CONTRACT §4.4）
WORKER_ROLE=all

# Web 服务端口（容器内监听端口，与 compose ports 映射对应）
PORT=3000

# 旁白音频：public/ 下的 staticFile 相对路径（渲染 payload 的 audio.narration）
ZHIYING_NARRATION_PATH=full/audio/FullCut_TTS.wav

# ============ M2-B：LLM（docs/M2-B_实现说明.md）============
# Provider 选择：mock | deepseek。production 禁止 mock 且必须显式配置；
# 未配置时 dev/test fallback mock 并告警。
LLM_PROVIDER=mock

# DeepSeek API Key：仅环境变量，永不入库/入 Git/打印。LLM_PROVIDER=deepseek 时必需。
# DEEPSEEK_API_KEY=

# 阶段模型覆盖（可选，仅覆盖模型名；thinking 由 stage-models.ts 显式决定）：
# LLM_STAGE_MODEL_RESEARCH=deepseek-v4-pro
