# 运行时数据（DB、bundle 缓存、渲染输出）—— volume 挂载，不进镜像
data/

# 大型媒体资源（约 455MB）—— volume 只读挂载，不进镜像
public/full
public/pilot

# 依赖与构建产物——镜像内重新安装/构建
node_modules
.next

# 样例数据与临时文件
samples
_skilltmp

# 版本控制与本地环境
.git
*.tsbuildinfo
next-env.d.ts

# compose / 部署文档不进 build context（镜像不需要）
Dockerfile
docker-compose.yml
docker-compose.production.yml
DEPLOY.md
docs/

# 测试脚本不进镜像（container gate 测试由宿主动态挂载）
scripts/

# 所有环境配置文件禁止进入 build context（.env 前缀与 *.env 后缀全覆
# .env.production、.env.production.local、API-KEY.env 等）；只保留无 secret 模板
.env*
*.env
!.env.example

# 任何音频/视频/数据库二进制绝不进 build context
**/*.wav
**/*.mp3
**/*.mp4
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Python 本地环境
**/.venv/
**/__pycache__/

# 真实 production voice registry（repo 只保留 *.example.json，运行时 volume 挂载）
voice-registry.json

# production runtime/deployment state（reference voice、admin proposed compose）
/voices/
/_m4c1/
